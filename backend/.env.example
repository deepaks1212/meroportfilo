# ── Server ──────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────
# Local:
MONGO_URI=mongodb://localhost:27017/portfolio_db

# OR MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio_db?retryWrites=true&w=majority

# ── Email (Nodemailer via Gmail) ─────────
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password   # Use Gmail App Password, NOT your real password
EMAIL_TO=your_email@example.com       # Where contact form messages are forwarded

# ── Frontend URL (for CORS) ──────────────
CLIENT_URL=http://localhost:3000

# ── Optional: Anthropic API (AI auto-reply) ──
ANTHROPIC_API_KEY=your_anthropic_key_here
